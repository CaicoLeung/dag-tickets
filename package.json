{
  "name": "dag-tickets",
  "version": "0.1.1",
  "description": "DAG-aware CLI that drives a batch of GitHub issues through implement → code-review → PR → merge, fanning independent tickets out across Paseo worktrees and serialising the rest in dependency order.",
  "type": "module",
  "license": "MIT",
  "author": "Caico Leung",
  "homepage": "https://github.com/CaicoLeung/dag-tickets#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/CaicoLeung/dag-tickets.git"
  },
  "bugs": {
    "url": "https://github.com/CaicoLeung/dag-tickets/issues"
  },
  "bin": {
    "dag-tickets": "./bin/dag-tickets.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "dag-tickets": "bun run bin/dag-tickets.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
